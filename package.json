{
  "name": "workly-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "db:migrate": "wrangler d1 migrations apply workly-db --local --config wrangler.local.jsonc",
    "db:migrate:remote": "node --env-file=.env node_modules/wrangler/bin/wrangler.js d1 migrations apply workly-db --remote",
    "db:seed": "wrangler d1 execute workly-db --local --config wrangler.local.jsonc --file=db/seed.sql",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:check": "node --env-file=.env scripts/check-cloudflare.mjs",
    "db:setup:remote": "node --env-file=.env scripts/setup-cloudflare.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.14",
    "aws4fetch": "^1.0.20",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "latest",
    "postcss": "latest",
    "prettier": "latest",
    "tailwindcss": "4.3.3",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "wrangler": "4.155.0"
  },
  "overrides": {
    "glob": "13.0.6",
    "formdata-node": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261023.1": true,
    "core-js@3.51.0": false
  }
}
